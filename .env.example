# Shared by the Postgres service and Phoenix dev/test config. Project creation sets it in .env.
# Password accepts [A-Za-z0-9_-]; placeholder/default passwords are rejected.
POSTGRES_PASSWORD=replace-with-a-generated-private-password
# Dedicated loopback port, 1..65535 excluding 5432; check it is free first.
POSTGRES_PORT=54321

# Claude Code subscription OAuth token; generate it with `mix claude_code.setup_token`.
CLAUDE_CODE_OAUTH_TOKEN=replace-with-your-claude-code-oauth-token

# Erlang distribution cookie shared by `make iex` and Livebook. Project creation sets it in .env.
# Generate: openssl rand -hex 24. Accepts [A-Za-z0-9_-]; placeholders are rejected.
BORG_DIST_COOKIE=replace-with-a-generated-private-cookie
# Optional node short name ([a-z][a-z0-9_]*); set it when another checkout already runs `make iex`.
# BORG_NODE_NAME=domovoy

# Optional Livebook settings; change all of them when another checkout runs Livebook too.
# LIVEBOOK_PORT=8080
# LIVEBOOK_IFRAME_PORT=8081
# LIVEBOOK_PROJECT=domovoy-livebook
